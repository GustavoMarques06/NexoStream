# Environment for running the real binaries against docker-compose.dev.yml.
# Development only: these credentials are public.
NEXOSTREAM_DATABASE_URL=postgres://nexostream:nexostream-dev-only@127.0.0.1:5432/nexostream?sslmode=disable
NEXOSTREAM_REDIS_URL=redis://127.0.0.1:6379/0
NEXOSTREAM_NATS_URL=nats://127.0.0.1:4222
NEXOSTREAM_JWT_KEY=dev-only-jwt-key-change-me-0123456789abcdef
NEXOSTREAM_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
NEXOSTREAM_HTTP_ADDR=127.0.0.1:8080
NEXOSTREAM_PANEL_DIR=web-panel/dist
NEXOSTREAM_WORKER_ID=dev-01
NEXOSTREAM_HLS_DIR=var/hls
NEXOSTREAM_STATE_DIR=var/worker
NEXOSTREAM_DVR_DIR=var/dvr
NEXOSTREAM_METRICS_ADDR=127.0.0.1:9500
NEXOSTREAM_MEDIA_ADDR=127.0.0.1:9500
NEXOSTREAM_PUBLIC_HLS_BASE=http://127.0.0.1:9500/hls
NEXOSTREAM_PUBLIC_TS_BASE=http://127.0.0.1:9500/live
NEXOSTREAM_LOG_LEVEL=debug
