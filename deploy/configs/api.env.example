# /etc/nexostream/api.env  (root:nexostream, 640)
NEXOSTREAM_HTTP_ADDR=127.0.0.1:8080
NEXOSTREAM_DATABASE_URL=postgres://nexostream_api@10.10.0.10:5432/nexostream?sslmode=verify-full
NEXOSTREAM_DATABASE_PASSWORD_FILE=/etc/nexostream/db-api.password
NEXOSTREAM_DB_MIGRATE=true
NEXOSTREAM_REDIS_URL=rediss://10.10.0.10:6379/0
NEXOSTREAM_REDIS_PASSWORD_FILE=/etc/nexostream/redis.password
NEXOSTREAM_NATS_URL=tls://10.10.0.10:4222
NEXOSTREAM_NATS_CREDS=/etc/nexostream/api.creds
# At least 32 random bytes: openssl rand -hex 32 > /etc/nexostream/jwt.key
NEXOSTREAM_JWT_KEY_FILE=/etc/nexostream/jwt.key
# First start only: creates the admin when the users table is empty.
# Delete the file after the first login and change the password in the panel.
NEXOSTREAM_BOOTSTRAP_ADMIN_USER=admin
NEXOSTREAM_BOOTSTRAP_ADMIN_PASSWORD_FILE=/etc/nexostream/bootstrap-admin.password
NEXOSTREAM_TRUST_PROXY=true
# Proxies (IP ou CIDR, separados por vírgula) além do loopback cujo X-Real-IP / X-Forwarded-For é aceito.
# NEXOSTREAM_TRUSTED_PROXIES=
NEXOSTREAM_DEFAULT_PROFILE=hd
# Signs playback tokens of channels with DRM (same file as on the Media
# Nodes; at least 32 random bytes).
#NEXOSTREAM_PLAYBACK_TOKEN_KEY_FILE=/etc/nexostream/playback-token.key
# Account lockout after repeated failed sign-ins (defaults shown; a negative
# threshold turns it off). See docs/api.md, section 2.1.
#NEXOSTREAM_LOCKOUT_THRESHOLD=5
#NEXOSTREAM_LOCKOUT_BASE=5m
#NEXOSTREAM_LOCKOUT_MAX=1h
NEXOSTREAM_ACCESS_TOKEN_TTL=15m
NEXOSTREAM_REFRESH_TOKEN_TTL=12h
NEXOSTREAM_LOG_LEVEL=info
# Optional: serve the panel from the API instead of nginx.
#NEXOSTREAM_PANEL_DIR=/usr/share/nexostream/panel
# Optional: TLS directly on the API (normally nginx terminates TLS).
#NEXOSTREAM_TLS_CERT_FILE=/etc/nexostream/tls/api.crt
#NEXOSTREAM_TLS_KEY_FILE=/etc/nexostream/tls/api.key
