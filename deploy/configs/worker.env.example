# /etc/nexostream/worker.env  (root:nexostream, 640)
NEXOSTREAM_WORKER_ID=media-01
NEXOSTREAM_NATS_URL=tls://10.10.0.10:4222
NEXOSTREAM_NATS_CREDS=/etc/nexostream/worker.creds
NEXOSTREAM_HLS_DIR=/var/lib/nexostream/hls
# Default DVR folder of this node (channels can use their own folder or a
# RAID storage defined in the panel / config editor).
NEXOSTREAM_DVR_DIR=/srv/nexostream/dvr
# Logo images channels can burn into the video (a channel names a file here,
# never a path). Copy the same files to every Media Node.
NEXOSTREAM_OVERLAY_DIR=/var/lib/nexostream/overlays
NEXOSTREAM_STATE_DIR=/var/lib/nexostream/worker
# /metrics and /healthz on the management network (Prometheus). Unauthenticated
# plain HTTP: bind it to the management address only. The default, when unset,
# is 127.0.0.1:9500.
NEXOSTREAM_METRICS_ADDR=10.10.0.21:9500
# MPEG-TS over HTTP relay, proxied by nginx (/<channel>/stream.ts).
NEXOSTREAM_MEDIA_ADDR=127.0.0.1:9501
# Optional: serve the media address over HTTPS (TLS 1.2 or newer) so viewers,
# tokens and DVR playback are encrypted without a proxy in front. Both files
# together. With a separate METRICS_ADDR, /metrics stays plain HTTP: keep it on
# the management network.
#NEXOSTREAM_TLS_CERT_FILE=/etc/nexostream/tls/worker.crt
#NEXOSTREAM_TLS_KEY_FILE=/etc/nexostream/tls/worker.key
# Public URLs reported in the channel status.
NEXOSTREAM_PUBLIC_HLS_BASE=https://origin.example.local
NEXOSTREAM_PUBLIC_TS_BASE=https://origin.example.local
NEXOSTREAM_PUBLIC_DVR_BASE=https://origin.example.local/dvr
NEXOSTREAM_INGEST_INTERFACES=eno2,eno3
NEXOSTREAM_FFMPEG_PATH=/usr/bin/ffmpeg
NEXOSTREAM_FFPROBE_PATH=/usr/bin/ffprobe
NEXOSTREAM_UDP_READ_BUFFER=4194304
NEXOSTREAM_HLS_SEGMENT_SECONDS=6
NEXOSTREAM_HLS_LIST_SIZE=10
NEXOSTREAM_DEFAULT_PROFILE=hd
NEXOSTREAM_ALLOW_HEVC_PASSTHROUGH=false
# DRM (channels with "drm aes-128"). Both files: at least 32 random bytes,
# openssl rand -hex 32. DRM_KEY derives the content keys and must be the
# SAME on every Media Node; PLAYBACK_TOKEN_KEY is the same on the nodes and
# on the API. Without them, protected channels are not served.
#NEXOSTREAM_DRM_KEY_FILE=/etc/nexostream/drm.key
#NEXOSTREAM_PLAYBACK_TOKEN_KEY_FILE=/etc/nexostream/playback-token.key
NEXOSTREAM_LOG_LEVEL=info
