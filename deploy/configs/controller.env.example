# /etc/nexostream/controller.env  (root:nexostream, 640)
NEXOSTREAM_DATABASE_URL=postgres://nexostream_controller@10.10.0.10:5432/nexostream?sslmode=verify-full
NEXOSTREAM_DATABASE_PASSWORD_FILE=/etc/nexostream/db-controller.password
NEXOSTREAM_REDIS_URL=rediss://10.10.0.10:6379/0
NEXOSTREAM_REDIS_PASSWORD_FILE=/etc/nexostream/redis.password
NEXOSTREAM_NATS_URL=tls://10.10.0.10:4222
NEXOSTREAM_NATS_CREDS=/etc/nexostream/controller.creds
NEXOSTREAM_RECONCILE_INTERVAL=5s
# 3 missed heartbeats (5 s each).
NEXOSTREAM_WORKER_OFFLINE_AFTER=15s
NEXOSTREAM_STARTUP_GRACE=11s
NEXOSTREAM_DRAIN_MIGRATIONS_PER_PASS=5
NEXOSTREAM_DEFAULT_PROFILE=hd
NEXOSTREAM_EVENTS_RETENTION=168h
# Scheduler. The costs are PROVISIONAL: calibrate them with the Phase 3/8 benchmarks.
NEXOSTREAM_MAX_CPU_PERCENT=80
NEXOSTREAM_COST_PASSTHROUGH=0.2
NEXOSTREAM_COST_TRANSCODE_PER_MEGAPIXEL=4
NEXOSTREAM_COST_GPU_OFFLOAD=4
# Redundancy (ADR 0010): run this service on two or more machines; only the
# holder of the "controller" lease in PostgreSQL reconciles.
NEXOSTREAM_CONTROLLER_ID=control-01
NEXOSTREAM_LEADER_LEASE_TTL=15s
NEXOSTREAM_LOG_LEVEL=info
