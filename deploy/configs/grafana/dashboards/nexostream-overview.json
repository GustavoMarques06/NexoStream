{
  "title": "NexoStream — Visão geral",
  "uid": "nexostream-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["nexostream"],
  "templating": {
    "list": [
      { "name": "worker", "type": "query", "datasource": { "uid": "prometheus" }, "query": "label_values(nexostream_worker_channels, worker_id)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } },
      { "name": "channel", "type": "query", "datasource": { "uid": "prometheus" }, "query": "label_values(nexostream_channel_up, channel_id)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "panels": [
    { "id": 1, "type": "stat", "title": "Canais no ar", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(nexostream_channel_up)" }] },
    { "id": 2, "type": "stat", "title": "Canais em FAILED", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "sum(nexostream_channel_state{state=\"FAILED\"})" }] },
    { "id": 3, "type": "stat", "title": "Canais em backup", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } },
      "targets": [{ "expr": "sum(nexostream_channel_state{state=~\"ON_BACKUP|RECOVERING\"})" }] },
    { "id": 4, "type": "stat", "title": "Entrada total", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "targets": [{ "expr": "sum(rate(nexostream_channel_input_bytes_total[1m])) * 8" }] },
    { "id": 5, "type": "stat", "title": "Reinícios (1 h)", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(nexostream_pipeline_restarts_total[1h]))" }] },
    { "id": 6, "type": "stat", "title": "Espectadores TS/HTTP", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(nexostream_viewers)" }] },
    { "id": 7, "type": "timeseries", "title": "Bitrate de entrada por canal", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }, "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "targets": [{ "expr": "rate(nexostream_channel_input_bytes_total{channel_id=~\"$channel\"}[1m]) * 8", "legendFormat": "{{channel_id}}" }] },
    { "id": 8, "type": "timeseries", "title": "Erros de continuidade por minuto", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(nexostream_channel_cc_errors_total{channel_id=~\"$channel\"}[5m]) * 60", "legendFormat": "{{channel_id}}" }] },
    { "id": 9, "type": "state-timeline", "title": "Estado dos canais", "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "max by (channel_id, state) (nexostream_channel_state{channel_id=~\"$channel\"}) == 1", "legendFormat": "{{channel_id}} {{state}}" }] },
    { "id": 10, "type": "timeseries", "title": "Canais por worker", "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 }, "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "nexostream_worker_channels{worker_id=~\"$worker\"}", "legendFormat": "{{worker_id}}" }] },
    { "id": 11, "type": "timeseries", "title": "CPU por nó", "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 }, "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [{ "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100", "legendFormat": "{{instance}}" }] },
    { "id": 12, "type": "timeseries", "title": "Trocas de fonte e reinícios", "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 }, "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(nexostream_channel_source_switches_total[5m]))", "legendFormat": "trocas de fonte" },
        { "expr": "sum(increase(nexostream_pipeline_restarts_total[5m]))", "legendFormat": "reinícios" }
      ] },
    { "id": 13, "type": "logs", "title": "Logs do worker (Loki)", "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 }, "datasource": { "uid": "loki" },
      "targets": [{ "expr": "{job=\"nexostream\"} | json | level=~\"warn|error\"" }] }
  ]
}
